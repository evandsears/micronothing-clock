<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">

    <!-- Crisp high-res rendered canvas view matching Nothing OS 5.0 -->
    <ImageView
        android:id="@+id/widget_canvas_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_description" />

    <!-- Hotspot overlay for interaction when calendar is visible (4-row mode) -->
    <LinearLayout
        android:id="@+id/hotspot_container_calendar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Row 1: Clock click zone (Date, Time, Timezone) -->
        <FrameLayout
            android:id="@+id/hotspot_clock"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Row 2: Weather click zone (Temp, Condition, Forecast) -->
        <FrameLayout
            android:id="@+id/hotspot_weather"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Rows 3 & 4: Calendar click zone (Event Title & Countdown) -->
        <FrameLayout
            android:id="@+id/hotspot_calendar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2" />

    </LinearLayout>

    <!-- Hotspot overlay for interaction when calendar is hidden (2-row mode) -->
    <LinearLayout
        android:id="@+id/hotspot_container_no_calendar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Row 1: Clock click zone (50%) -->
        <FrameLayout
            android:id="@+id/hotspot_clock_no_cal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Row 2: Weather click zone (50%) -->
        <FrameLayout
            android:id="@+id/hotspot_weather_no_cal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</FrameLayout>
